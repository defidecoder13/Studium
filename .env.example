# ==========================================
# 1. NEON DB POSTGRESQL CONNECTION STRING
# ==========================================
# Get your free serverless Postgres URL from https://neon.tech
DATABASE_URL="postgresql://user:password@ep-restless-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# 2. BETTER-AUTH CONFIGURATION
# ==========================================
# Generate a random 32+ char secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-better-auth-key-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# ==========================================
# 3. GOOGLE GEMINI AI API KEY
# ==========================================
GEMINI_API_KEY="your-google-gemini-api-key-here"

# ==========================================
# 4. CLOUDFLARE R2 OBJECT STORAGE (10 GB FREE)
# ==========================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="studium-pdfs"
R2_PUBLIC_URL="https://pub-yourbucketid.r2.dev"
