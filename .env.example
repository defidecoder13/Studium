# ==========================================
# 1. NEON DB POSTGRESQL CONNECTION STRING
# ==========================================
# Get your free serverless Postgres URL from https://neon.tech
DATABASE_URL="postgresql://user:password@ep-restless-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# 2. CLERK AUTHENTICATION CONFIGURATION
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app/dashboard"
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/app/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/app/dashboard"

# ==========================================
# 3. GOOGLE GEMINI AI API KEY
# ==========================================
GEMINI_API_KEY="your-google-gemini-api-key-here"

# ==========================================
# 4. CLOUDFLARE R2 OBJECT STORAGE (10 GB FREE)
# ==========================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="studium"
# Optional — only if you use a custom R2 public domain.
# Studium serves files via /api/documents/file/[key] proxy by default, so this can stay empty on Vercel.
R2_PUBLIC_URL=""

# ==========================================
# 5. APP URL (canonical production URL)
# ==========================================
# Used for sitemap.xml / robots.txt. Set to your Vercel domain in prod.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
